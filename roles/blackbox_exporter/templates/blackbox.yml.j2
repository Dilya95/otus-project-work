modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      method: GET
      preferred_ip_protocol: ip4
      valid_status_codes:
        - 200
        - 301
        - 302
      tls_config:
        insecure_skip_verify: true

  wordpress_https:
    prober: http
    timeout: 10s
    http:
      method: GET
      preferred_ip_protocol: ip4
      valid_status_codes:
        - 200
        - 301
        - 302
      headers:
        Host: project.local
      tls_config:
        insecure_skip_verify: true
