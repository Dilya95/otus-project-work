#!/usr/sbin/nft -f

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0;
        policy drop;

        iifname "lo" accept

        ct state established,related accept
        ct state invalid drop

        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

        ip saddr {{ management_network }} tcp dport 22 accept
        ip saddr {{ vagrant_nat_gateway }} tcp dport 22 accept

        ip saddr {{ backend01_db_ip }} tcp dport 3306 accept
        ip saddr {{ backend02_db_ip }} tcp dport 3306 accept

        ip saddr {{ db01_db_ip }} tcp dport 3306 accept
        ip saddr {{ db02_db_ip }} tcp dport 3306 accept

        ip saddr {{ monitoring_ip }} tcp dport {{ node_exporter_port }} accept
        ip saddr {{ monitoring_ip }} tcp dport {{ mysqld_exporter_port }} accept
    }

    chain forward {
        type filter hook forward priority 0;
        policy drop;
    }

    chain output {
        type filter hook output priority 0;
        policy accept;
    }
}
