[Unit]
Description=Grafana Loki
Wants=network-online.target
After=network-online.target

[Service]
User={{ loki_user }}
Group={{ loki_group }}
Type=simple

ExecStart=/usr/local/bin/loki \
    -config.file={{ loki_config_dir }}/loki.yml

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
