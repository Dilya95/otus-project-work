global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "127.0.0.1:{{ alertmanager_port }}"

rule_files:
  - "{{ prometheus_config_dir }}/rules/*.yml"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "127.0.0.1:{{ prometheus_port }}"

  - job_name: node_exporter
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - "{{ hostvars[host]['management_ip'] }}:{{ node_exporter_port }}"
{% endfor %}

  - job_name: mysqld_exporter
    static_configs:
      - targets:
          - "192.168.56.31:{{ mysqld_exporter_port }}"
        labels:
          db_role: primary

      - targets:
          - "192.168.56.32:{{ mysqld_exporter_port }}"
        labels:
          db_role: replica

  - job_name: blackbox_frontend
    metrics_path: /probe
    params:
      module:
        - wordpress_https
    static_configs:
      - targets:
          - "https://192.168.56.10"
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target

      - source_labels:
          - __param_target
        target_label: instance

      - target_label: __address__
        replacement: "127.0.0.1:{{ blackbox_exporter_port }}"

  - job_name: blackbox_backends
    metrics_path: /probe
    params:
      module:
        - http_2xx
    static_configs:
      - targets:
          - "http://192.168.56.21"
          - "http://192.168.56.22"
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target

      - source_labels:
          - __param_target
        target_label: instance

      - target_label: __address__
        replacement: "127.0.0.1:{{ blackbox_exporter_port }}"
